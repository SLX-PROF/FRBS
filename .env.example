# База данных (dev на Mac: localhost; в docker compose: db)
DATABASE_URL=postgresql://forbsa:forbsa_dev_password@localhost:5432/forbsa

# Для docker compose (задаёт пароль контейнера db и подставляется в DATABASE_URL выше)
POSTGRES_USER=forbsa
POSTGRES_PASSWORD=forbsa_dev_password
POSTGRES_DB=forbsa

# Секрет Payload (в проде — длинная случайная строка!)
PAYLOAD_SECRET=dev-secret-change-in-prod

# Basic Auth перед /admin (доп. слой поверх логина Payload, см. src/middleware.ts).
# Без этих двух переменных /admin отдаёт 401 всем — задать обязательно в проде.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# Занавеска "сайт в разработке" на весь сайт, кроме /admin (см. src/middleware.ts).
# Публика видит /coming-soon; обойти можно ссылкой forbsa.ru/?preview=<этот_секрет>
# (ставит куку на 30 дней). Уберите переменную и перезапустите контейнер для релиза.
SITE_PREVIEW_SECRET=

# Базовый URL для ссылок в письмах/уведомлениях (без завершающего слэша)
SERVER_URL=http://localhost:3000

# Уведомления (SP3)
# Ключ для внешнего планировщика: curl -H "x-cron-key: $CRON_SECRET" $SERVER_URL/api/cron/notify
CRON_SECRET=dev-cron-secret-change-in-prod
# Дней без движения по сделке до напоминания владельцу
SLA_DAYS=5
# Токен Telegram-бота; без него telegram-уведомления пропускаются (шлётся только e-mail)
TELEGRAM_BOT_TOKEN=

# E-mail: без адаптера Payload пишет письма в консоль. Для прода добавить
# @payloadcms/email-nodemailer и SMTP-параметры (SMTP_HOST/PORT/USER/PASS).

# Чат-бот (SP5) — YandexGPT. Без ключей бот работает в демо-режиме (мок).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite
